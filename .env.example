# OpsAI Environment Configuration Example

# Server & Network
PORT=8080
APP_FRONTEND_ORIGIN=http://localhost:5173
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Settings
DB_HOST=postgres
DB_PORT=5432
DB_USER=opsai_user
DB_PASSWORD=opsai_secure_password_change_me
DB_NAME=opsai_db
DB_SSLMODE=disable
POSTGRES_PORT=5432

# Encryption Keys (Base64-encoded 32-byte keys for encrypting SSH credentials & AI model keys)
# Generate with: openssl rand -base64 32
SERVER_KEY_ENCRYPTION_KEY=
MODEL_KEY_ENCRYPTION_KEY=

# Security & Session
COOKIE_SECURE=false
SESSION_TTL=720h
SSH_CONNECT_TIMEOUT=15s
MODEL_REQUEST_TIMEOUT=60s
